# Copy this file to .env and fill in real values. Never commit .env.

# Used by the `flask` CLI (init-db, import-legacy, hash-password)
FLASK_APP=tasa_website

# Any long random string; sessions are invalidated when it changes
SECRET_KEY=change-me

# Admin login. Generate the hash with: flask hash-password
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# 1 = debug mode + auto reload (never on the live server)
FLASK_DEBUG=1

# Optional: absolute path to the sqlite file.
# Defaults to instance/tasa_website.db inside the repo.
# DATABASE_PATH=
